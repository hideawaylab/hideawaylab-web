# Hideaway Lab CEO Workspace Authentication & AI Engine
# 실제 값은 서버의 .env.local 파일에만 설정하세요. (Git 커밋 금지)

# 대표자 로그인 이메일
CEO_EMAIL=k072810@gmail.com

# scrypt 비밀번호 해시 (형식: salt:hexHash)
# 서버에서 node 스크립트로 생성해 입력하세요. (README.md 참고)
CEO_PASSWORD_HASH=

# 세션 서명용 32바이트 랜덤 비밀키 (예: openssl rand -hex 32)
AUTH_SECRET=

# Phase 2: Google AI Studio Gemini API Key (무료 티어 또는 유료 키)
GEMINI_API_KEY=
